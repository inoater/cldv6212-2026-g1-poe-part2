        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 4000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"The queued order was written to the Orders table\", function () {",
                  "    const orders = pm.response.json();",
                  "    pm.expect(orders).to.be.an('array');",
                  "    const order = orders.find(o => o.RowKey === pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect(order, 'order is in the Orders table').to.exist;",
                  "    pm.expect(['Received', 'Preparing', 'Ready', 'Collected']).to.include(order.Status);",
                  "});"
                ]
              }
            }
          ],
