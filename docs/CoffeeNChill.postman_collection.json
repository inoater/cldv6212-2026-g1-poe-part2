    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const orderId = \"ORD-2026-\" + Math.floor(100000 + Math.random() * 900000);",
                  "pm.collectionVariables.set(\"orderId\", orderId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test(\"Response echoes the queued order\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.OrderId).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect(jsonData.CustomerName).to.eql(\"Jane Smith\");",
                  "    pm.expect(jsonData.SelectedItemSKUs).to.eql([\"COF-001\", \"PAS-104\"]);",
                  "    pm.expect(jsonData.TotalPrice).to.eql(65);",
                  "    pm.expect(jsonData.OrderTimestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            },
            "description": "Validates the order, serializes it to JSON and places it on order-processing-queue. A fresh OrderId is generated before each run",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"OrderId\": \"{{orderId}}\",\n    \"CustomerName\": \"Jane Smith\",\n    \"SelectedItemSKUs\": [\n        \"COF-001\",\n        \"PAS-104\"\n    ],\n    \"TotalPrice\": 65.00,\n    \"OrderTimestamp\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Place Order (Generated ID and Timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test(\"OrderId and OrderTimestamp were generated\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.OrderId).to.match(/^ORD-\\d{4}-[0-9A-F]{6}$/);",
                  "    pm.expect(jsonData.OrderTimestamp).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set(\"generatedOrderId\", jsonData.OrderId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
