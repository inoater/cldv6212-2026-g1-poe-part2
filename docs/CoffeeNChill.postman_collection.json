          "name": "Get Order By Id (Received)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Order was logged with status Received\", function () {",
                  "    const order = pm.response.json();",
                  "    pm.expect(order.RowKey).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect(order.PartitionKey).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "    pm.expect(order.CustomerName).to.eql(\"Jane Smith\");",
                  "    pm.expect(order.SelectedItemSKUs).to.eql(\"COF-001,PAS-104\");",
                  "    pm.expect(order.TotalPrice).to.eql(65);",
